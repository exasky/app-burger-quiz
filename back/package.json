{
  "name": "app-burger-quiz",
  "version": "1.0.0",
  "description": "Application pour jouer à burger-quiz",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "cp -r views dist/views && mkdirp -p dist/node_modules/qrcode/build && cp -r node_modules/qrcode/build/ dist/node_modules/qrcode/",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "bcrypt-nodejs": "^0.0.3",
    "body-parser": "^1.18.3",
    "colors": "^1.4.0",
    "connect-flash": "^0.1.1",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "figlet": "1.9.3",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "qrcode": "^1.4.4",
    "serverless-http": "4.0.0",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.2",
    "@types/figlet": "^1.7.0",
    "@types/jquery": "^3.5.16",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.12",
    "@types/passport-local": "^1.0.35",
    "@types/socket.io": "^3.0.1",
    "mkdirp": "^3.0.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "author": "Poutriquet Benjamin",
  "license": "MIT"
}
