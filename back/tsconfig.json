{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "allowJs": false,
    "moduleResolution": "node",
    "types": ["node", "jquery"]
  },
  "include": [
    "app/**/*.ts",
    "config/**/*.ts",
    "utils/**/*.ts",
    "server.ts"
  ],
  "exclude": ["node_modules", "dist", "views/public/js"]
}
